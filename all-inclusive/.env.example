# SCTTRD ALL-INCLUSIVE .env — Secrets auf dem Server (NICHT committen!)
#   cp .env.example .env ; alle "change" ersetzen.

# --- Domains ---
WEB_DOMAIN=scttrd.de
WEBSITE_URL=https://scttrd.de

# --- CMS (Payload) ---
CMS_DB_NAME=scttrd_cms
CMS_DB_USER=cms
CMS_DB_PASSWORD=change-me-cms-db
PAYLOAD_SECRET=change-me-payload-secret-64hex

# --- Wiki (Docmost) ---
DOCMOST_DB_NAME=docmost
DOCMOST_DB_USER=docmost
DOCMOST_DB_PASSWORD=change-me-docmost-db
DOCMOST_APP_SECRET=change-me-docmost-secret-64hex

# --- Site-Fallback fürs Web-Build ---
PAYLOAD_URL=https://cms.scttrd.de

# --- Mail / SMTP ---
# Ein Postfach für alle drei Dienste:
#   Website -> Benachrichtigung bei neuen Rider-Anfragen
#   CMS     -> Passwort-Zurücksetzen-Mails
#   Wiki    -> Einladungs- und Reset-Mails
# ACHTUNG: Port 993 ist IMAP (Abrufen) und funktioniert hier NICHT.
# Versand: 587 mit STARTTLS (SMTP_SECURE=false) oder 465 mit SSL (SMTP_SECURE=true).
# Ohne SMTP_HOST bleibt der Versand überall aus, alles andere läuft normal weiter.
SMTP_HOST=w021c25a.kasserver.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@scttrd.de
SMTP_PASSWORD=change-me-mail-password
MAIL_FROM_ADDRESS=info@scttrd.de
MAIL_FROM_NAME=SCTTRD

# Empfänger der Rider-Benachrichtigungen
RIDER_MAIL_TO=info@scttrd.de
