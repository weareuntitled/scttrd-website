---
interface NavLink {
  label: string;
  url: string;
}

interface Props {
  currentPath: string;
  nextShowUrl: string | null;
}

const { currentPath, nextShowUrl } = Astro.props;
const showsHref = currentPath === '/' ? '#shows' : '/#shows';
const menuLinks: NavLink[] = [
  { label: 'Shows', url: showsHref },
  { label: 'Linkhub', url: '/links/' },
  { label: 'Galerie', url: '/gallery/' },
];
---

<header class="site-header" data-site-header data-open="false">
  <a class="site-brand" href="/" aria-label="SCTTRD Startseite">
    <img width="66" height="66" alt="SCTTRD" src="/images/Frame-179-2.png" loading="eager" />
  </a>
  {nextShowUrl && <a class="site-next" href={nextShowUrl}>Next Show ↗</a>}
  <button
    class="site-burger"
    type="button"
    data-site-burger
    aria-expanded="false"
    aria-controls="site-nav"
    aria-label="Menü öffnen"
  >
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <nav class="site-nav" id="site-nav" data-site-nav aria-label="SCTTRD Navigation">
    {menuLinks.map((link) => (
      <a href={link.url} aria-current={link.url === currentPath ? 'page' : undefined}>{link.label}</a>
    ))}
    {nextShowUrl && <a class="site-nav-next" href={nextShowUrl}>Next Show ↗</a>}
  </nav>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const button = header?.querySelector('[data-site-burger]');
  const nav = header?.querySelector('[data-site-nav]');
  const setOpen = (open) => {
    header?.setAttribute('data-open', String(open));
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
  };
  button?.addEventListener('click', () => {
    const open = header?.getAttribute('data-open') !== 'true';
    setOpen(open);
    if (open) nav?.querySelector('a')?.focus();
  });
  header?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setOpen(false);
      button?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    min-height: 80px;
    padding: 0 max(18px, calc((100vw - 1180px) / 2));
    border-bottom: 2px solid #0c0c0c;
    background: #f00000;
    color: #0c0c0c;
  }
  .site-brand { display: block; flex: 0 0 auto; width: 66px; height: 66px; }
  .site-brand img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .site-nav { display: flex; flex: 1 1 auto; align-items: center; justify-content: flex-start; gap: clamp(20px, 3vw, 40px); min-width: 0; }
  .site-nav a {
    color: inherit;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .1em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .site-nav a:hover, .site-nav a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .site-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .site-next {
    flex: 0 0 auto;
    margin-left: auto;
    padding: 12px 15px;
    border: 2px solid #0c0c0c;
    background: #0c0c0c;
    color: #f00000;
    box-shadow: 4px 4px 0 rgba(12, 12, 12, .25);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .site-next:hover, .site-next:focus-visible {
    background: transparent;
    color: #0c0c0c;
    box-shadow: 2px 2px 0 #0c0c0c;
    transform: translate(2px, 2px);
  }
  .site-nav-next { display: none; }
  .site-burger {
    display: none;
    flex: 0 0 auto;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    min-width: 44px;
    min-height: 44px;
    padding: 10px;
    border: 2px solid #0c0c0c;
    background: transparent;
    cursor: pointer;
  }
  .site-burger span { display: block; width: 20px; height: 2px; background: #0c0c0c; }
  .site-burger:focus-visible, .site-brand:focus-visible, .site-next:focus-visible { outline: 3px solid #0c0c0c; outline-offset: 3px; }
  @media (max-width: 767px) {
    .site-header { display: flex; flex-wrap: wrap; gap: 14px; min-height: 64px; padding-block: 12px; }
    .site-brand { width: 45px; height: 45px; }
    .site-next { margin-left: auto; padding: 10px 12px; }
    .site-burger { display: inline-flex; }
    .site-nav {
      display: none;
      order: 3;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 12px;
      border-top: 1px solid rgba(12, 12, 12, .35);
    }
    .site-header[data-open='true'] .site-nav { display: flex; }
    .site-nav a { padding: 12px 4px; font-size: 12px; border-bottom: 1px solid rgba(12, 12, 12, .18); }
    .site-nav a:last-child { border-bottom: 0; }
    .site-nav-next { display: block; }
  }
</style>
