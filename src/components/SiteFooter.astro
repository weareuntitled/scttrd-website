---
interface Props {
  email?: string;
}

const { email = 'info@scttrd.de' } = Astro.props;
---

<div class="footer">
  <div class="wrapper">
    <div class="footer-container">
      <div class="footer-links">
        <a href="/#shows" class="footer-link">shows</a>
        <a href="/gallery/" class="footer-link">gallery</a>
        <a href="/styleguide/#presse" class="footer-link">press pack</a>
        <a href={`mailto:${email}?subject=STTRD%20Reqzest`} class="footer-link">{email}</a>
      </div>
    </div>
  </div>
</div>

<style>
  .footer {
    z-index: 2;
    position: relative;
    margin: 0;
    background: #f00000;
    color: #0c0c0c;
    font-family: Poppins, sans-serif;
  }
  .wrapper { width: min(100% - 36px, 1120px); margin-inline: auto; padding: 0; }
  .footer-container { display: flex; justify-content: space-between; padding-block: 30px; }
  .footer-links { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: center; gap: 16px; width: 100%; }
  .footer-link { display: flex; align-items: center; min-height: 44px; margin: 0; color: #0c0c0c; text-decoration: none; overflow-wrap: anywhere; }
  .footer-link:hover, .footer-link:focus-visible { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 767px) {
    .footer-links { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 16px; padding-block: 16px; }
    .footer-container { width: 100%; justify-content: flex-start; align-items: center; padding: 0; }
  }
</style>
