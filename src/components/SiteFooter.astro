---
interface Props {
  email?: string;
}

const { email = 'info@scttrd.de' } = Astro.props;
---

<div class="footer">
  <div class="wrapper">
    <div class="footer-container">
      <div class="footer-links">
        <a href="/#shows" class="footer-link">shows</a>
        <a href="/gallery/" class="footer-link">gallery</a>
        <a href="/styleguide/#presse" class="footer-link">press pack</a>
        <a href={`mailto:${email}?subject=STTRD%20Reqzest`} class="footer-link">{email}</a>
      </div>
    </div>
  </div>
</div>

<style>
  .footer {
    z-index: 2;
    position: relative;
    margin: 0;
    background: #f00000;
    color: #0c0c0c;
    font-family: Poppins, sans-serif;
  }
  .wrapper { width: 100%; max-width: 1728px; margin-inline: auto; padding-inline: 20px; }
  .footer-container { display: flex; justify-content: space-between; padding-block: 30px; }
  .footer-links { display: flex; justify-content: space-around; align-items: center; width: 100%; }
  .footer-link { display: block; margin: 0; color: #0c0c0c; text-decoration: none; }
  @media (max-width: 767px) {
    .footer { margin-inline: 20px; }
    .wrapper { margin: 0; padding: 0; }
    .footer-links { justify-content: space-around; min-width: 0; height: 10vh; margin-bottom: 0; font-family: 'Inter Tight', Poppins, sans-serif; }
    .footer-container { width: 100%; justify-content: flex-start; align-items: center; padding: 0; }
  }
</style>
