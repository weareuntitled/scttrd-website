---
import { newsUrl } from '../lib/news.ts';

interface Props {
  articles: {
    title: string;
    slug: string;
    excerpt: string;
    cover: string;
    coverAlt?: string;
    publishedAt: string;
  }[];
}
const { articles } = Astro.props;
const formatDate = (value: string) => new Date(value).toLocaleDateString('de-DE', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
---

<section class="home-news" id="news" aria-labelledby="home-news-heading">
  <div class="wrapper">
    <header class="home-news-heading">
      <h2 id="home-news-heading">News</h2>
      <a href="/news/">Alle News</a>
    </header>
    <div class="home-news-grid">
    {articles.map((article, index) => <article class="home-news-card" data-entry data-entry-delay={index * 80}>
      <a class="home-news-image" href={newsUrl(article)} aria-label={`Artikel lesen: ${article.title}`}>
        <img src={article.cover} alt={article.coverAlt || article.title} loading="lazy" width="900" height="675" />
      </a>
      <div class="home-news-copy">
        <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
        <h3><a href={newsUrl(article)}>{article.title}</a></h3>
        <p>{article.excerpt}</p>
        <a class="home-news-read" href={newsUrl(article)}>Artikel lesen <span aria-hidden="true">↗</span></a>
      </div>
    </article>)}
    </div>
  </div>
</section>

<style>
  .home-news { padding-block: clamp(56px, 7vw, 104px); background: #0c0c0c; color: #f00000; font-family: Poppins, sans-serif; }
  .home-news-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; margin-bottom: 32px; }
  .home-news-heading h2 { margin: 0; color: inherit; font-family: Poppins, sans-serif; font-size: var(--type-section); font-weight: 800; line-height: 1.1; letter-spacing: -.025em; text-transform: uppercase; }
  .home-news a { color: inherit; }
  .home-news-heading > a { flex-shrink: 0; padding-block: 12px; font-size: 14px; text-underline-offset: 5px; }
  .home-news-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .home-news-card { display: flex; flex-direction: column; min-width: 0; border: 1px solid #f00000; }
  .home-news-image { display: block; }
  .home-news-image img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .home-news-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 24px; }
  .home-news-copy time { font-size: 13px; }
  .home-news-copy h3 { margin: 16px 0; color: inherit; font-family: Poppins, sans-serif; font-size: var(--type-card); font-weight: 800; line-height: 1.1; letter-spacing: -.025em; text-transform: uppercase; }
  .home-news-copy h3 a { font: inherit; letter-spacing: inherit; text-decoration: none; }
  .home-news-copy p { max-width: 48ch; margin: 0 0 28px; font-size: 16px; line-height: 1.6; }
  .home-news-read { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 48px; margin-top: auto; padding-block: 12px; border-top: 1px solid currentColor; font-size: 15px; text-decoration: none; }
  .home-news a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .home-news a:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }
  @media (max-width: 991px) { .home-news-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .home-news-grid { grid-template-columns: 1fr; }
    .home-news-heading { margin-bottom: 24px; }
    .home-news-copy h3 { font-size: clamp(32px, 8vw, 46px); }
  }
</style>
