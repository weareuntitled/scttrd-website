<body class="body-container">
  <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
  <SiteHeader currentPath="/" nextShowUrl={nextShowHref} />
  <div class="custom-cursor-container"><div class="custom-cursor"><div class="custom-cursor-text">see project</div></div></div>
  <div class="body-content-wrapper">
    <main id="main-content">
    <section class="section-home-hero">
      <div class="home-hero-text">
        <div class="home-hero-headline"><h1 class="home-hero-headline-strech">SCTTRD</h1></div>
      </div>
      <div class="wrapper relative">
        <div class="home-hero-img-container" data-tilt>
          <img class="home-hero-img _1" src={homeHeroImage1} alt={homeImages?.data.heroImage1Alt ?? ''} loading="eager" fetchpriority="high">
          <img class="home-hero-img _2" src={homeHeroImage2} alt={homeImages?.data.heroImage2Alt ?? ''} loading="lazy">
        </div>
      </div>
      {nextShow && (
        <div class="home-hero-cta wrapper">
          <a class="home-hero-next" href={nextShowHref ?? '#'}>
            <span class="home-hero-next-label">Next Show</span>
            <strong class="home-hero-next-show">{nextShow.data.venue}</strong>
            <span class="home-hero-next-meta">{nextShow.data.city} · {nextShow.data.date}</span>
            <span class="home-hero-next-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      )}
    </section>
    <section class="section-about" id="about">
      <div class="wrapper">
        <div class="about-grid">
          <div id="w-node-_529206b4-7da0-2990-4c60-98b86e7763c4-269f9a25" class="about-section-name"><div class="section-name"><p></p></div></div>
          <div id="w-node-_61c881b4-2eb7-871b-4876-6bf2bfaa1b2b-269f9a25" data-w-id="61c881b4-2eb7-871b-4876-6bf2bfaa1b2b" style="opacity:0" class="about-section-content"><h2><strong class="bold-text">{homePage?.text ?? homeText?.data.text}</strong></h2></div>
          <div id="w-node-cd29ea5f-7453-d826-cc6d-399efe605862-269f9a25" class="about-divider-container"><div data-w-id="e874bee6-fa6b-19ee-6d1e-429f4ee903e7" style="width:0%" class="about-divider-line"></div></div>
          <div id="w-node-ec49d079-7c20-fd16-182a-884cbce6489d-269f9a25" class="about-section-empty"></div>
          <div id="w-node-_255ae96c-450a-d978-a401-15ae2c42833a-269f9a25" data-w-id="255ae96c-450a-d978-a401-15ae2c42833a" style="opacity:0" class="about-section-content"><h5 class="heading"><strong>SCTTRD. Augsburg, Germany. <br></strong>{homeText?.data.bio_de}</h5></div>
        </div>
      </div>
    </section>
    <section class="section-bento" aria-label="On stage">
      <div class="wrapper">
          <div class="bento-head"><div class="section-name"><h2 class="paragraph">on stage</h2></div></div>
        <div class="bento-grid">
          <div class="bento-item bento-hero" style="grid-column:1/3;grid-row:1/3;">
            <video src="/videos/radio-rudina/clip.mp4" poster="/videos/radio-rudina/poster.jpg" muted loop playsinline preload="none" data-autoplay></video>
            <span class="bento-label">Radio Rudina</span>
          </div>
          <div class="bento-item" style="grid-column:3;grid-row:1;"><video src="/videos/reels/komod-c0086.web.mp4" muted loop playsinline preload="none" data-autoplay></video><span class="bento-label">Komod</span></div>
          <div class="bento-item" style="grid-column:3;grid-row:2;"><video src="/videos/reels/komod-052.web.mp4" muted loop playsinline preload="none" data-autoplay></video><span class="bento-label">Komod</span></div>
          {reels.slice(0, 3).map((r, i) => (
            <div class="bento-item" style={`grid-column:${i + 1};grid-row:3;`}>
              <video src={r.data.video} poster={r.data.poster} muted loop playsinline preload="none" data-autoplay></video>
              <span class="bento-label">{r.data.title}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="section-customers" id="shows">
      <div class="wrapper customers-upcoming">
        <div class="customers-grid">
          <h2 class="customers-section-description customers-since">scttrd<br />since<br />2023</h2>
          <div class="customers-text"><div class="section-name"><h2 class="paragraph">upcoming shows</h2></div></div>
          <p class="customers-section-description"></p>
          <div class="customers-list"><Customers shows={upcomingShows} kind="upcoming" pinFirst={Boolean(nextShow)} /></div>
        </div>
      </div>
      <div class="wrapper customers-past">
        <div class="customers-grid">
          <div class="customers-text"><div class="section-name"><h2 class="paragraph">past shows</h2></div></div>
          <div class="customers-list"><Customers shows={pastShows} kind="past" /></div>
        </div>
      </div>
    </section>
    <section data-w-id="1e6660fa-f36e-5c5e-6ffc-2b382155db17" class="section-cta">
      <div data-w-id="2cd76ce8-424e-4aa5-8299-e3d9fa2583c4" class="cta-video-container">
        {videos[0] && (() => {
          const v = videos[0].data;
          return (
        <div data-poster-url={v.poster} data-video-urls={`${v.video},${v.video.replace('.mp4', '.webm')}`} data-autoplay="true" data-loop="true" data-wf-ignore="true" class="cta-video w-background-video w-background-video-atom"><video id="9d825163-9107-8bf1-969e-60774207e73f-video" autoplay="" loop="" aria-label="SCTTRD Live-Moment" style={{ backgroundImage: `url(&quot;${v.poster}&quot;)` }} muted="" playsinline="" data-wf-ignore="true" data-object-fit="cover">
            <source src={v.video} data-wf-ignore="true">
            <source src={v.video.replace('.mp4', '.webm')} data-wf-ignore="true">
          </video></div>
          );
        })()}
      </div>
      <div class="cta-text">
        <div class="wrapper">
          <div data-w-id="bb3f2a80-5f68-8b27-91b3-956af024382e" class="cta-text-container">
            <div class="cta-text-headline"><h3 class="cta-text-headline-pt1">{homeText?.data.cta_headline ?? 'Want to book us?'}</h3></div>
            <a href={`mailto:info@scttrd.de?subject=${homeText?.data.cta_button_email_subject ?? 'Booking%20SCTTRD'}`} class="button w-inline-block"><div class="button-arrow-container"></div><div class="button-text">{homeText?.data.cta_button ?? 'Book us here'}</div></a>
          </div>
        </div>
      </div>
    </section>
    </main>
    <div class="footer">
      <div class="wrapper">
        <div class="footer-container">
          <div class="footer-links"><a href="/#shows" class="footer-link">shows</a><a href="/gallery/" class="footer-link">gallery</a><a href="/styleguide/#presse" class="footer-link">press pack</a><a href="mailto:info@scttrd.de?subject=STTRD%20Reqzest" class="link">{homeText?.data.email ?? 'info@scttrd.de'}</a></div>
        </div>
      </div>
    </div>
  </div>
  <script is:inline src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6729da1e7ab5d6b5269f99bb" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script is:inline src="js/webflow.js" type="text/javascript"></script>
  <style is:global>
     html, body { max-width: 100%; overflow-x: hidden; }
     .skip-link { position: fixed; top: 8px; left: 8px; z-index: 100; padding: 12px 16px; background: #0c0c0c; color: #f00000; transform: translateY(-150%); transition: transform .2s ease; }
     .skip-link:focus { transform: translateY(0); }
     .section-bento { background-color: var(--dark); color: var(--white, #fff); padding: 80px 0 120px; overflow: hidden; }
    .bento-head { margin-bottom: 30px; } .bento-head .paragraph { color: var(--color); }
    .bento-grid { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: 240px 240px 240px; gap: 10px; }
    .bento-item { position: relative; border-radius: 10px; overflow: hidden; background: #1a1a1a; }
    .bento-item video { display: block; width: 100%; height: 100%; object-fit: cover; }
    .bento-hero { grid-column: 1 / 3; grid-row: 1 / 3; }
    .bento-label { position: absolute; left: 12px; bottom: 12px; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--color); font-weight: 700; z-index: 2; }
     @media (max-width: 767px) { .bento-grid { grid-template-columns: 1fr; grid-template-rows: auto; } .bento-item { grid-column: auto !important; grid-row: auto !important; aspect-ratio: 16 / 9; } }
     .home-hero-img-container[data-tilt] { perspective: 900px; grid-template-columns: 1fr 1.12fr !important; margin-top: -48px !important; }
     .home-hero-img-container[data-tilt] .home-hero-img { transition: transform .4s cubic-bezier(.22,1,.36,1); will-change: transform; height: auto !important; }
     .home-hero-text { position: relative; z-index: 2; }
     .home-hero-img-container[data-tilt] { position: relative; z-index: 1; }
     .home-hero-img._1, .home-hero-img._2 { width: 100%; max-width: none; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 8px; margin-top: 0 !important; }
    .section-home-hero .wrapper.relative { position: relative; }
    [style*="opacity:0"] { opacity: 1 !important; }
    @media (max-width: 767px) { .home-hero-img-container[data-tilt] { grid-template-columns: 1fr !important; margin-top: 0 !important; } .home-hero-img._1, .home-hero-img._2 { margin-top: 0 !important; } }
    .nav-link-el-container { min-height: 44px; display: flex; align-items: center; }
     @font-face { font-family: Founders; src: url('/fonts/TestFoundersGrotesk-Medium.otf'); font-weight: 500; font-display: swap; }
     @font-face { font-family: Founders; src: url('/fonts/TestFoundersGrotesk-Semibold.otf'); font-weight: 800 900; font-display: swap; }
     @media (prefers-reduced-motion: reduce) { .home-hero-img-container[data-tilt] .home-hero-img, .home-hero-next, .home-hero-next-arrow { transition: none !important; } }
     .home-hero-cta { margin-top: clamp(28px, 6vw, 72px); }
     .customers-empty { grid-column: 1 / -1; margin: 0; padding: 24px 0; border-bottom: 1px solid #000; color: #000; font-size: 17px; }
     .customers-section-description { font-size: var(--text-heading) !important; line-height: 1.1; font-weight: 800; }
     .customers-since { display: none; }
    .home-hero-next {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: flex-start;
      min-height: clamp(220px, 32vh, 320px);
      padding: clamp(28px, 4vw, 48px);
      border: 2px solid var(--dark, #0c0c0c);
      background: var(--dark, #0c0c0c);
      color: #f00000;
      text-decoration: none;
      box-shadow: 8px 8px 0 rgba(12, 12, 12, .28);
      font-family: Founders, Arial, sans-serif;
      overflow: hidden;
      transition: transform .18s ease, background .18s ease, color .18s ease, box-shadow .18s ease;
    }
    .home-hero-next::before {
      position: absolute;
      inset: 0;
      content: '';
      pointer-events: none;
      opacity: .1;
      background-image: linear-gradient(135deg, transparent 0 49%, #f00000 49% 50%, transparent 50% 100%);
      background-size: 26px 26px;
    }
    .home-hero-next:hover, .home-hero-next:focus-visible {
      background: transparent;
      color: var(--dark, #0c0c0c);
      box-shadow: 4px 4px 0 #0c0c0c;
      transform: translate(4px, 4px);
    }
    .home-hero-next-label {
