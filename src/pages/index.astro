  </style>
  <script is:inline>
     (() => {
       const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
       if (reducedMotion) document.querySelectorAll('video[autoplay]').forEach((video) => { video.pause(); video.removeAttribute('autoplay'); });
       const io = new IntersectionObserver((entries) => {
         entries.forEach((e) => {
           const v = e.target;
           if (e.isIntersecting && !reducedMotion) { v.muted = true; v.load && v.load(); v.play && v.play().catch(() => {}); }
           else v.pause && v.pause();
         });
       }, { threshold: 0.1 });
       if (!reducedMotion) document.querySelectorAll('video[data-autoplay]').forEach((v) => io.observe(v));
      const tiltEls = document.querySelectorAll('[data-tilt]');
      if (tiltEls.length && window.matchMedia('(hover: hover)').matches) {
        tiltEls.forEach((el) => {
          const imgs = el.querySelectorAll('.home-hero-img');
          el.addEventListener('mousemove', (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            imgs.forEach((img, i) => { const f = i === 0 ? 6 : -6; img.style.transform = `rotateX(${(-y * f).toFixed(2)}deg) rotateY(${(x * f).toFixed(2)}deg)`; });
          });
          el.addEventListener('mouseleave', () => { imgs.forEach((img) => (img.style.transform = 'rotateX(0deg) rotateY(0deg)')); });
        });
      }
    })();
  </script>
