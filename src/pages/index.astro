  <style is:global>
    .section-bento { background-color: var(--dark); color: var(--white, #fff); padding: 80px 0 120px; overflow: hidden; }
    .bento-head { margin-bottom: 30px; } .bento-head .paragraph { color: var(--color); }
    .bento-grid { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: 240px 240px 240px; gap: 10px; }
    .bento-item { position: relative; border-radius: 10px; overflow: hidden; background: #1a1a1a; }
    .bento-item video { display: block; width: 100%; height: 100%; object-fit: cover; }
    .bento-hero { grid-column: 1 / 3; grid-row: 1 / 3; }
    .bento-label { position: absolute; left: 12px; bottom: 12px; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--color); font-weight: 700; z-index: 2; }
    @media (max-width: 767px) { .bento-grid { grid-template-columns: 1fr; grid-template-rows: auto; } .bento-item { grid-column: auto !important; grid-row: auto !important; aspect-ratio: 16 / 9; } }
    .home-hero-img-container[data-tilt] { perspective: 900px; grid-template-columns: 1fr 1.12fr !important; margin-top: -48px !important; }
    .home-hero-img-container[data-tilt] .home-hero-img { transition: transform .4s cubic-bezier(.22,1,.36,1); will-change: transform; height: auto !important; }
    .home-hero-img._1 { max-width: 100%; object-fit: cover; border-radius: 8px; margin-top: -24px !important; }
    .home-hero-img._2 { max-width: 100%; object-fit: cover; border-radius: 8px; margin-top: 32px !important; }
    .section-home-hero .wrapper.relative { position: relative; }
    [style*="opacity:0"] { opacity: 1 !important; }
    @media (max-width: 767px) { .home-hero-img-container[data-tilt] { grid-template-columns: 1fr !important; margin-top: 0 !important; } .home-hero-img._1, .home-hero-img._2 { margin-top: 0 !important; } }
    .nav-link-el-container { min-height: 44px; display: flex; align-items: center; }
  </style>
  <script is:inline>
    (() => {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          const v = e.target;
          if (e.isIntersecting) { v.muted = true; v.load && v.load(); v.play && v.play().catch(() => {}); }
          else v.pause && v.pause();
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('[data-autoplay]').forEach((v) => io.observe(v));
      const tiltEls = document.querySelectorAll('[data-tilt]');
      if (tiltEls.length && window.matchMedia('(hover: hover)').matches) {
        tiltEls.forEach((el) => {
          const imgs = el.querySelectorAll('.home-hero-img');
          el.addEventListener('mousemove', (e) => {
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            imgs.forEach((img, i) => { const f = i === 0 ? 6 : -6; img.style.transform = `rotateX(${(-y * f).toFixed(2)}deg) rotateY(${(x * f).toFixed(2)}deg)`; });
          });
          el.addEventListener('mouseleave', () => { imgs.forEach((img) => (img.style.transform = 'rotateX(0deg) rotateY(0deg)')); });
        });
      }
    })();
  </script>
