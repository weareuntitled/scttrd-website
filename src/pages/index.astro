---
import { getCollection } from 'astro:content';
import Customers from '../components/Customers.astro';
import * as Termin from '../lib/termin.js';

const shows = (await getCollection('shows'));
const navLinks = (await getCollection('links')).sort((a, b) => a.data.order - b.data.order);
const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order);
const reels = (await getCollection('reels')).sort((a, b) => a.data.order - b.data.order);
const [homeText] = await getCollection('homeText');
const [homeImages] = await getCollection('homeImages');
const homeHeroImage1 = homeImages?.data.heroImage1 ?? '/images/about_04.jpg';
const homeHeroImage2 = homeImages?.data.heroImage2 ?? '/images/about_01.jpg';
const upcomingShows = Termin.upcoming(shows);
const pastShows = Termin.past(shows);
