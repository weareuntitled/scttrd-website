---
import { getCollection } from 'astro:content';
import Customers from '../components/Customers.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { isoDate, past as hubPast, nextShow as hubNextShow, orderedUpcoming, showUrl } from '../lib/show.ts';
import { getPage, getShows } from '../lib/cms.ts';
import '../styles/tokens.css';

const shows = (await getShows()) as any;
const homePage = (await getPage('home')) as any;
const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order);
const reels = (await getCollection('reels')).sort((a, b) => a.data.order - b.data.order);
const [homeText] = await getCollection('homeText');
const [homeImages] = await getCollection('homeImages');
const homeHeroImage1 = homeImages?.data.heroImage1 ?? '/images/about_04.jpg';
const homeHeroImage2 = homeImages?.data.heroImage2 ?? '/images/about_01.jpg';
const upcomingShows = orderedUpcoming(shows);
const pastShows = hubPast(shows);
const nextShow = hubNextShow(shows);
const nextShowHref = nextShow ? showUrl(nextShow) : null;
const siteUrl = 'https://scttrd.de';
const pageTitle = 'SCTTRD - Elektronisches Live-Projekt aus Augsburg';
const pageDescription = 'SCTTRD ist ein elektronisches Live-Projekt aus Augsburg zwischen Post-Punk, Techno und Trance. Echte Shows, keine DJs.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MusicGroup',
      '@id': `${siteUrl}/#scttrd`,
      name: 'SCTTRD',
      url: siteUrl,
      description: pageDescription,
      genre: ['Post-Punk', 'Techno', 'Trance'],
      foundingDate: '2023',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Augsburg',
        addressCountry: 'DE',
      },
      email: `mailto:${homeText?.data.email ?? 'info@scttrd.de'}`,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'SCTTRD',
      url: siteUrl,
      publisher: { '@id': `${siteUrl}/#scttrd` },
    },
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}/#webpage`,
      name: pageTitle,
      url: siteUrl,
      description: pageDescription,
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': `${siteUrl}/#scttrd` },
    },
    ...(nextShow && isoDate(nextShow.data.date)
      ? [{
          '@type': 'Event',
          name: `${nextShow.data.venue} - SCTTRD`,
          startDate: isoDate(nextShow.data.date),
          url: `${siteUrl}${nextShowHref}`,
          image: nextShow.data.image ? `${siteUrl}${nextShow.data.image}` : undefined,
          eventStatus: 'https://schema.org/EventScheduled',
          eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
          location: {
            '@type': 'Place',
            name: nextShow.data.venue,
            address: {
              '@type': 'PostalAddress',
              addressLocality: nextShow.data.city,
              addressCountry: 'DE',
            },
          },
          performer: { '@id': `${siteUrl}/#scttrd` },
        }]
      : []),
  ],
};
