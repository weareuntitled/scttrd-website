---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGallery, getShows } from '../lib/cms.ts';
import { nextShow as hubNextShow, showUrl } from '../lib/show.ts';
import { absoluteUrl, DEFAULT_OG_IMAGE } from '../lib/seo.ts';
import '../styles/tokens.css';

const images = await getGallery();
const shows = await getShows();
const next = hubNextShow(shows);
const nextShowUrl = next ? showUrl(next) : null;
// Der Atlas wiederholt die Bilder endlos. Wir zeigen zuerst die kuratierten
// Pressefotos und füllen mit einer gleichmäßigen Auswahl der übrigen auf.
const curated = images.filter((image) => image.src.startsWith('/images/'));
const remote = images.filter((image) => !image.src.startsWith('/images/'));
const spread = remote.filter((_, index) => index % Math.max(1, Math.ceil(remote.length / 8)) === 0);
const gridItems = [...curated.slice(0, 24), ...spread.slice(0, 8)].slice(0, 32).map((image, index) => ({
  image: image.src,
  alt: image.alt,
  title: image.alt,
  meta: String(index + 1).padStart(2, '0'),
}));

const ogImage = absoluteUrl(gridItems[0]?.image ?? DEFAULT_OG_IMAGE);
const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'SCTTRD Galerie',
  description: 'Live, backstage und Pressebilder von SCTTRD.',
  url: 'https://scttrd.de/gallery/',
  image: images.slice(0, 32).map((image) => ({
    '@type': 'ImageObject',
    contentUrl: absoluteUrl(image.src),
    description: image.alt,
  })),
};
---
<BaseLayout
  title="Galerie | SCTTRD"
  description="SCTTRD Galerie: live, backstage und Pressebilder."
  currentPath="/gallery/"
  nextShowUrl={nextShowUrl}
  canonical="https://scttrd.de/gallery/"
  image={ogImage}
>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(gallerySchema)} />
    <main class="gallery-page">
      <h1 class="gallery-sr">SCTTRD Galerie</h1>
      <p class="gallery-sr">Live, backstage und Pressebilder von SCTTRD aus Augsburg: Konzerte in Tiefgaragen und Clubs, Aufnahmen von unterwegs, Porträts aus dem Pressekit.</p>
      <div
        class="gallery-grid"
        data-fisheye
        data-items={JSON.stringify(gridItems)}
        role="region"
        tabindex="0"
        aria-label="Unendliche Bilderwand. Ziehen oder Pfeiltasten benutzen."
      >
        <canvas aria-hidden="true"></canvas>
        <div class="gallery-vignette" aria-hidden="true"></div>
        <p class="gallery-hint">Ziehen, scrollen, Pfeiltasten.</p>
        <ul class="gallery-fallback">
          {images.map((image) => (
            <li><img src={image.src} alt={image.alt} loading="lazy" /></li>
          ))}
        </ul>
      </div>
    </main>

    <script is:inline>document.documentElement.classList.add('has-js');</script>
    <script>
      import { initFisheyeGrid } from '../lib/fisheyeGrid.ts';
      const root = document.querySelector<HTMLElement>('[data-fisheye]');
      if (root) initFisheyeGrid(root, JSON.parse(root.dataset.items ?? '[]'), { theme: 'dark' });
    </script>
</BaseLayout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #0c0c0c; color: #f00000; font-family: Poppins, system-ui, sans-serif; }
  /* Full bleed: die Wand sitzt über die gesamte Seitenbreite, ohne Innenabstand. */
  .gallery-page { width: 100%; margin: 0; padding: 0; }
  .gallery-grid {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 520px;
    overflow: hidden;
    background: #060606;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .gallery-grid[data-dragging='true'] { cursor: grabbing; }
  .gallery-grid:focus-visible { outline: 3px solid #f00000; outline-offset: -3px; }
  .gallery-grid canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .gallery-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at center, transparent 48%, rgba(0, 0, 0, .32) 100%);
  }
  .gallery-hint {
    position: absolute;
    z-index: 2;
    right: clamp(18px, 4vw, 64px);
    bottom: clamp(18px, 4vw, 64px);
    margin: 0;
    padding: 10px 14px;
    border: 2px solid #f00000;
    background: rgba(12, 12, 12, .82);
    color: #f00000;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  /* Ohne JavaScript (oder ohne WebGL) bleibt die statische Liste sichtbar. */
  .gallery-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery-fallback li { overflow: hidden; background: #0c0c0c; }
  .gallery-fallback img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Mit JS übernimmt die Leinwand; die Liste bleibt für Suchmaschinen im DOM. */
  :global(html.has-js) .gallery-fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .gallery-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 700px) {
    .gallery-grid { height: 100vh; min-height: 420px; }
    .gallery-fallback { grid-template-columns: repeat(2, 1fr); }
  }
</style>
