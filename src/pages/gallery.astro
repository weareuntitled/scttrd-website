---
import { getGallery } from '../lib/cms.ts';
import '../styles/tokens.css';

const images = await getGallery();
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Galerie | SCTTRD</title>
    <meta name="description" content="SCTTRD Galerie: live, backstage und Pressebilder." />
  </head>
  <body>
    <main class="gallery-page">
      <header class="gallery-header">
        <a href="/" class="gallery-back">SCTTRD</a>
        <h1>Galerie</h1>
        <a href="/" class="gallery-back">zurück</a>
      </header>
      <section class="gallery-grid" aria-label="SCTTRD Galerie">
        {images.map((image) => (
          <figure><img src={image.src} alt={image.alt} loading="lazy" /></figure>
        ))}
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f4f1ea; color: #111; font-family: Arial, sans-serif; }
  .gallery-page { max-width: 1440px; margin: auto; padding: 28px clamp(18px, 4vw, 64px) 72px; }
  .gallery-header { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 48px; border-bottom: 2px solid #111; padding-bottom: 14px; }
  h1 { margin: 0; font-size: clamp(42px, 9vw, 128px); line-height: .85; letter-spacing: -.08em; text-transform: uppercase; }
  .gallery-back { color: inherit; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; }
  .gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  figure { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; background: #ddd; }
  img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  figure:hover img { transform: scale(1.04); }
  @media (max-width: 700px) { .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; } .gallery-header { margin-bottom: 28px; } }
</style>
