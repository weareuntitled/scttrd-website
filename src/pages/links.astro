---
import { getLinkHub, getLinks, getShows } from '../lib/cms.ts';
import { upcoming as hubUpcoming, nextShow as hubNextShow, showUrl, parseDate, isoDate } from '../lib/show.ts';
import { trackedTicketUrl } from '../lib/tracking.ts';

const hub: any = await getLinkHub();
const links: any[] = await getLinks();
const shows: any[] = await getShows();
const upcoming = hubUpcoming(shows);
const next = hubNextShow(shows);
const monthShort = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];
const profileName = hub?.profile?.handle || '@scttrd_ofc';
const profileTitle = hub?.profile?.title || 'SCTTRD Official Music';
const profileDescription = hub?.profile?.description || 'Brutal, aber schoen. Live zwischen Post-Punk, Techno und Trance.';
const profileImage = hub?.profile?.image?.url || 'https://scttrd.de/images/00_scttrd_graded_-29.jpg';
const seoTitle = hub?.seo?.title || `${profileTitle} | ${profileName}`;
const seoDescription = hub?.seo?.description || profileDescription;
const socialLinks = links.filter((link) => ['spotify', 'soundcloud', 'instagram', 'youtube'].includes(link.platform));
const sameAs = socialLinks.map((link) => link.url);
const spotifyUrl: string | undefined = hub?.featuredRelease?.spotify;
let release: any = null;
if (spotifyUrl) {
  try {
    const oembed = await fetch(`https://open.spotify.com/oembed?url=${encodeURIComponent(spotifyUrl)}`, { signal: AbortSignal.timeout(3000) } as any);
    if (oembed.ok) {
      const data = await oembed.json();
      release = { title: data.title, cover: data.thumbnail_url, url: spotifyUrl };
    }
  } catch {}
}
const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://scttrd.de/links/#profile',
  url: 'https://scttrd.de/links/',
  mainEntity: { '@type': 'Person', name: profileName, description: profileDescription, image: profileImage, sameAs },
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content="https://scttrd.de/links/" />
    <meta property="og:image" content={profileImage} />
    <meta property="og:type" content="profile" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://scttrd.de/links/" />
    <script type="application/ld+json" set:html={JSON.stringify(profileSchema)}></script>
  </head>
  <body>
    <main class="hub">
      <header>
        <img class="avatar" src={profileImage} alt="SCTTRD" />
        <h1 class="name">{profileName}</h1>
        <p class="bio">{profileDescription}</p>
      </header>
      {release && <a class="release-card" href={release.url} target="_blank" rel="noopener noreferrer">
        <img class="release-cover" src={release.cover} alt="" />
        <span class="release-body">
          <span class="release-type">Neuester Track</span>
          <strong class="release-title">{release.title}</strong>
          <span class="release-play">Auf Spotify anhoeren →</span>
        </span>
      </a>}
      {hub?.appearance?.showUpcoming !== false && upcoming.length > 0 && <section aria-labelledby="shows-title">
        <div class="section-heading"><h2 id="shows-title">Upcoming Shows</h2></div>
        {upcoming.map((show) => {
          const parsed = parseDate(show.data.date);
          const day = parsed ? String(parsed.day).padStart(2, '0') : '—';
          const month = parsed ? monthShort[parsed.month - 1] : 'tba';
          const machineDate = isoDate(show.data.date) ?? undefined;
          const showHref = showUrl(show);
          const hasTicket = Boolean(show.data.link);
          const chipHref = trackedTicketUrl(show, { source: 'linkhub', medium: 'show-card' }) ?? (hasTicket ? show.data.link : showHref);
          return <div class="show-row">
            <a class="show-main link-btn" href={showHref} aria-label={show === next ? `Nächste Show: ${show.data.venue}, ${show.data.city}` : undefined}>
              {show === next && <span class="show-next-badge">Next</span>}
              <time datetime={machineDate}><strong>{day}</strong><span>{month}</span></time>
              <span class="show-copy"><strong>{show.data.venue}</strong><span>{show.data.city}</span></span>
            </a>
            <a class="ticket-btn" href={chipHref} target={hasTicket ? '_blank' : undefined} rel={hasTicket ? 'noopener noreferrer' : undefined} aria-label={`Tickets für ${show.data.venue}`}>{hasTicket ? 'Tickets ↗' : 'Details ↗'}</a>
          </div>;
        })}
      </section>}
      <nav aria-label="SCTTRD Links">
        {links.map((link) => <a class="link-btn" href={link.url} target={link.target} rel={link.target === '_blank' ? 'noopener noreferrer' : undefined}>{link.cover && <img class="link-cover" src={link.cover} alt="" loading="lazy" />}{link.label}<span class="arrow">↗</span></a>)}
      </nav>
      <footer><a href="/">scttrd.de</a><a href="mailto:info@scttrd.de">booking</a></footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #000; color: #fff; font-family: Poppins, system-ui, sans-serif; }
  .hub { width: min(100% - 32px, 680px); margin: auto; padding: 36px 0 30px; min-height: 100vh; display: flex; flex-direction: column; }
  header { text-align: center; margin: 0 0 28px; }
  .avatar { width: 120px; height: 120px; object-fit: cover; border-radius: 50%; border: 4px solid #f00000; margin-bottom: 16px; }
  .name { margin: 0; font-size: 26px; font-weight: 800; letter-spacing: -.02em; }
  .bio { margin: 8px auto 0; max-width: 420px; font-size: 14px; line-height: 1.45; color: rgba(255,255,255,.7); }
  .release-card { display: flex; gap: 18px; align-items: center; margin-bottom: 28px; padding: 16px; background: #f00000; color: #000; border-radius: 4px; text-decoration: none; transition: transform .15s ease, box-shadow .15s ease; }
  .release-card:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(240,0,0,.4); }
  .release-cover { width: 96px; height: 96px; flex: 0 0 96px; object-fit: cover; }
  .release-body { min-width: 0; flex: 1; display: grid; gap: 4px; } .release-type { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; opacity: .65; } .release-title { font-size: 20px; font-weight: 800; letter-spacing: -.02em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .release-play { font-size: 12px; font-weight: 600; }
  .section-heading { margin: 0 0 12px; text-align: center; } .section-heading h2 { margin: 0; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: rgba(255,255,255,.55); }
  section, nav { display: grid; gap: 14px; margin-bottom: 26px; }
  a { color: inherit; }
  .link-btn { position: relative; display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 14px 20px; background: #111; border: 1px solid #2a2a2a; border-radius: 4px; font-size: 16px; font-weight: 700; text-align: center; text-decoration: none; transition: background .15s ease, border-color .15s ease, transform .15s ease; }
  .link-btn:hover { background: #f00000; border-color: #f00000; color: #000; transform: translateY(-2px); }
  .link-btn .arrow { font-size: 13px; opacity: .5; }
  .link-cover { width: 40px; height: 40px; flex: 0 0 40px; object-fit: cover; border-radius: 2px; }
  .show-btn { justify-content: flex-start; text-align: left; }
  .show-next-badge { flex: 0 0 auto; padding: 4px 8px; background: #f00000; color: #000; font-size: 10px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; border-radius: 2px; }
  .show-row { display: flex; gap: 10px; }
  .show-row .show-main { flex: 1; min-width: 0; justify-content: flex-start; text-align: left; }
  .ticket-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 128px; min-height: 56px; padding: 0 18px; background: #f00000; color: #000; border: 1px solid #f00000; border-radius: 4px; font-size: 13px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; text-decoration: none; transition: background .15s ease, border-color .15s ease, transform .15s ease; }
  .ticket-btn:hover, .ticket-btn:focus-visible { background: #fff; border-color: #fff; transform: translateY(-2px); }
  time { width: 44px; flex: 0 0 44px; display: grid; text-align: center; line-height: 1; } time strong { font-size: 20px; font-weight: 800; } time span { margin-top: 4px; font-size: 9px; text-transform: uppercase; font-weight: 700; color: rgba(255,255,255,.6); }
  .show-copy { min-width: 0; flex: 1; display: grid; gap: 3px; } .show-copy strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; } .show-copy span { font-size: 12px; color: rgba(255,255,255,.6); }
  footer { margin-top: auto; padding-top: 30px; display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.5); } footer a { color: inherit; text-decoration: none; }
  @media (max-width: 480px) { .hub { width: min(100% - 20px, 680px); padding-top: 28px; } .release-card { gap: 14px; } .release-cover { width: 80px; height: 80px; flex-basis: 80px; } .show-row { flex-wrap: wrap; } .ticket-btn { flex: 1 1 100%; min-height: 48px; } }
</style>
