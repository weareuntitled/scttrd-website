---
import { getLinkHub, getLinks, getShows, showSlug } from '../lib/cms.ts';

const hub: any = await getLinkHub();
const links: any[] = await getLinks();
const shows: any[] = await getShows();
const upcoming = shows.filter((show) => show.data.status === 'upcoming');
const profileName = hub?.profile?.handle || '@scttrd_ofc';
const profileTitle = hub?.profile?.title || 'SCTTRD Official Music';
const profileDescription = hub?.profile?.description || 'Brutal, aber schoen. Live zwischen Post-Punk, Techno und Trance.';
const profileImage = hub?.profile?.image?.url || 'https://scttrd.de/images/00_scttrd_graded_-29.jpg';
const seoTitle = hub?.seo?.title || `${profileTitle} | ${profileName}`;
const seoDescription = hub?.seo?.description || profileDescription;
const socialLinks = links.filter((link) => ['spotify', 'soundcloud', 'instagram', 'youtube'].includes(link.platform));
const sameAs = socialLinks.map((link) => link.url);
const parseShowDate = (value: string) => {
  const german = value.match(/^(\d{2})\.(\d{2})\.(\d{4})$/);
  return german ? new Date(`${german[3]}-${german[2]}-${german[1]}T12:00:00`) : new Date(`${value}T12:00:00`);
};
const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://scttrd.de/links/#profile',
  url: 'https://scttrd.de/links/',
  mainEntity: { '@type': 'Person', name: profileName, description: profileDescription, image: profileImage, sameAs },
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content="https://scttrd.de/links/" />
    <meta property="og:image" content={profileImage} />
    <meta property="og:type" content="profile" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://scttrd.de/links/" />
    <script type="application/ld+json" set:html={JSON.stringify(profileSchema)}></script>
  </head>
  <body>
    <main class="hub">
      <header>
        <img class="avatar" src={profileImage} alt="SCTTRD" />
        <h1 class="name">{profileName}</h1>
        <p class="bio">{profileDescription}</p>
      </header>
      {hub?.appearance?.showUpcoming !== false && upcoming.length > 0 && <section aria-labelledby="shows-title">
        <div class="section-heading"><h2 id="shows-title">Upcoming Shows</h2></div>
        {upcoming.map((show) => {
          const date = parseShowDate(show.data.date);
          const dateLabel = date.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
          const day = date.toLocaleDateString('de-DE', { day: '2-digit' });
          const month = date.toLocaleDateString('de-DE', { month: 'short' }).replace('.', '');
          return <a class="link-btn show-btn" href={`/shows/${showSlug(show.data.venue, show.data.date)}/`}>
            <time datetime={show.data.date}><strong>{day}</strong><span>{month}</span></time>
            <span class="show-copy"><strong>{show.data.venue}</strong><span>{show.data.city}</span></span>
            {show.data.link ? <span class="ticket">Tickets</span> : <span class="ticket">Info</span>}
          </a>;
        })}
      </section>}
      <nav aria-label="SCTTRD Links">
        {links.map((link) => <a class="link-btn" href={link.url} target={link.target} rel={link.target === '_blank' ? 'noopener noreferrer' : undefined}>{link.label}<span class="arrow">↗</span></a>)}
      </nav>
      {socialLinks.length > 0 && <div class="socials" aria-label="SCTTRD auf Social Media">
        {socialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.platform}><span class="dot" aria-hidden="true">{link.platform[0]?.toUpperCase()}</span></a>)}
      </div>}
      <footer><a href="/">scttrd.de</a><a href="mailto:info@scttrd.de">booking</a></footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f4f1ea; color: #111; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; }
  .hub { width: min(100% - 32px, 680px); margin: auto; padding: 36px 0 30px; min-height: 100vh; display: flex; flex-direction: column; }
  header { text-align: center; margin: 0 0 28px; }
  .avatar { width: 120px; height: 120px; object-fit: cover; border-radius: 50%; border: 4px solid #fff; box-shadow: 0 4px 18px rgba(0,0,0,.12); margin-bottom: 16px; }
  .name { margin: 0; font-size: 24px; font-weight: 700; letter-spacing: -.02em; }
  .bio { margin: 8px auto 0; max-width: 420px; font-size: 14px; line-height: 1.45; color: rgba(17,17,17,.72); }
  .section-heading { margin: 0 0 12px; text-align: center; } .section-heading h2 { margin: 0; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: rgba(17,17,17,.55); }
  section, nav { display: grid; gap: 14px; margin-bottom: 26px; }
  a { color: inherit; text-decoration: none; }
  .link-btn { position: relative; display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 14px 20px; background: #fff; border: 1px solid rgba(17,17,17,.08); border-radius: 14px; font-size: 16px; font-weight: 600; text-align: center; transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease; box-shadow: 0 2px 8px rgba(0,0,0,.05); }
  .link-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(0,0,0,.12); border-color: rgba(17,17,17,.2); }
  .link-btn .arrow { font-size: 13px; opacity: .5; }
  .show-btn { justify-content: flex-start; text-align: left; }
  time { width: 44px; flex: 0 0 44px; display: grid; text-align: center; line-height: 1; } time strong { font-size: 20px; font-weight: 800; } time span { margin-top: 4px; font-size: 9px; text-transform: uppercase; font-weight: 700; color: rgba(17,17,17,.6); }
  .show-copy { min-width: 0; flex: 1; display: grid; gap: 3px; } .show-copy strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; } .show-copy span { font-size: 12px; color: rgba(17,17,17,.6); }
  .ticket { font-size: 11px; font-weight: 700; padding: 6px 10px; border-radius: 999px; background: #f00000; color: #fff; }
  .socials { display: flex; justify-content: center; gap: 14px; margin-bottom: 26px; }
  .socials a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: #fff; border: 1px solid rgba(17,17,17,.08); box-shadow: 0 2px 8px rgba(0,0,0,.05); transition: transform .15s ease, box-shadow .15s ease; }
  .socials a:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(0,0,0,.12); }
  .dot { font-size: 15px; font-weight: 800; }
  footer { margin-top: auto; padding-top: 30px; display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: rgba(17,17,17,.5); }
  @media (max-width: 480px) { .hub { width: min(100% - 20px, 680px); padding-top: 28px; } }
</style>