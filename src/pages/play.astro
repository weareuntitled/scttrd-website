---
import { getReleases } from '../lib/cms.ts';
import { featuredRelease, releaseLink } from '../lib/release.ts';

// Smart-Link für Bio und Ads: öffnet beim Aufruf den neuesten Release direkt in Spotify.
const releases: any[] = await getReleases();
const release = featuredRelease(releases);
if (!release) return Astro.redirect('/links/');
const link = releaseLink(release);
if (!link.external) return Astro.redirect(link.href);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{release.title} | SCTTRD</title>
    <meta property="og:title" content={`${release.title} | SCTTRD`} />
    <meta property="og:image" content={release.cover} />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main>
      <img src={release.cover} alt={release.coverAlt || release.title} />
      <h1>{release.title}</h1>
      <a id="play-link" href={link.href}>In Spotify öffnen →</a>
      <a class="hub" href="/links/">Alle Links</a>
    </main>
    <script>
      import { spotifyAppLink } from '../lib/release.ts';

      const webLink = document.querySelector<HTMLAnchorElement>('#play-link')!;
      const appLink = spotifyAppLink(webLink.href, navigator.userAgent, { anyIosBrowser: true });
      if (appLink) {
        webLink.href = appLink;
        window.location.href = appLink;
      } else {
        window.location.replace(webLink.href);
      }
    </script>
  </body>
</html>

<style>
  body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #000; color: #fff; font-family: Poppins, sans-serif; }
  main { display: grid; gap: 16px; width: min(320px, calc(100vw - 32px)); padding: 32px 0; text-align: center; }
  img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
  h1 { margin: 8px 0 0; font-size: 28px; font-weight: 900; letter-spacing: -.02em; }
  #play-link { display: block; padding: 18px; color: #000; background: #f00000; font-size: 15px; font-weight: 900; text-decoration: none; }
  .hub { color: rgba(255,255,255,.65); font-size: 13px; font-weight: 700; }
</style>
