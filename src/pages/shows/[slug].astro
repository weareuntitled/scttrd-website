---
import { getLinks, getShows, showSlug } from '../../lib/cms.ts';
import * as Termin from '../../lib/termin.js';

const shows: any[] = await getShows();
const socialLinks = (await getLinks()).filter((item: any) => ['spotify', 'soundcloud', 'instagram'].includes(item.platform.toLowerCase()));
const nextShow = shows.filter((item) => item.data.status === 'upcoming').sort((a, b) => Termin.toTs(a.data.date) - Termin.toTs(b.data.date))[0];
const nextShowHref = nextShow && (nextShow.data.link || `/shows/${showSlug(nextShow.data.venue, nextShow.data.date)}/`);
const show = shows.find((item) => showSlug(item.data.venue, item.data.date) === Astro.params.slug);
if (!show) return Astro.redirect('/');
const { venue, city, date, status, image, imageAlt, link, lineup = [] } = show.data;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${venue}, ${city}`)}`;
const linkLabel = link && /youtube\.com|youtu\.be/i.test(link) ? 'Video ansehen ↗' : 'Veranstaltungsseite ↗';
const platformLabel = (url: string) => {
  const host = url.replace(/^https?:\/\//, '').replace(/^www\./, '');
  if (host.startsWith('instagram.com')) return 'Instagram';
  if (host.startsWith('open.spotify.com')) return 'Spotify';
  if (host.startsWith('soundcloud.com')) return 'SoundCloud';
  if (host.startsWith('youtube.com') || host.startsWith('youtu.be')) return 'YouTube';
  if (host.startsWith('tiktok.com')) return 'TikTok';
  return 'Webseite';
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{venue} | SCTTRD</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">SCTTRD <span aria-hidden="true"></span></a>
      <nav class="social-nav" aria-label="Social Media">
        <a href="/#shows">Alle Shows</a>
        {socialLinks.map((item: any) => <a href={item.url} target="_blank" rel="noopener noreferrer">{item.platform}</a>)}
      </nav>
      {nextShowHref && <a class="next-show" href={nextShowHref} target={/^https?:/i.test(nextShowHref) ? '_blank' : undefined} rel={/^https?:/i.test(nextShowHref) ? 'noopener noreferrer' : undefined}>Next Show ↗</a>}
    </header>
    <main class="show-page">
      {image && <div class="show-media"><img src={image} alt={imageAlt || venue} /></div>}
      <section class="show-copy">
        <p class="eyebrow">SCTTRD Live // {status === 'upcoming' ? 'Upcoming' : 'Archive'}</p>
        <h1>{venue}</h1>
        <div class="meta">
          <strong>{city} · {date}</strong>
          <a href={mapUrl} target="_blank" rel="noopener noreferrer">Ort in Google Maps öffnen ↗</a>
        </div>
        {lineup.length > 0 && <div class="lineup" id="lineup">
          <div class="lineup-head"><h2>Line-up</h2><span>{lineup.length} Acts</span></div>
          <ul>
            {lineup.map((artist) => <li>
              <strong>{artist.name}</strong>
              <span class="lineup-links">
                {artist.url && <a href={artist.url} target="_blank" rel="noopener noreferrer">{platformLabel(artist.url)} ↗</a>}
                {artist.sourceUrl && <a class="lineup-source" href={artist.sourceUrl} target="_blank" rel="noopener noreferrer">Quelle</a>}
              </span>
            </li>)}
          </ul>
        </div>}
        <div class="actions" id="tickets">
          {link ? <a class="ticket" href={link} target="_blank" rel="noopener noreferrer">{status === 'upcoming' ? 'Tickets sichern ↗' : linkLabel}</a> : status === 'upcoming' && <p class="muted">Ticketlink folgt.</p>}
        </div>
      </section>
    </main>
    <footer><strong>SCTTRD</strong><span>Brutal, aber schön.</span></footer>
  </body>
</html>

<style>
  @font-face { font-family: Founders; src: url('/fonts/TestFoundersGrotesk-Medium.otf'); font-weight: 500; font-display: swap; }
  @font-face { font-family: Founders; src: url('/fonts/TestFoundersGrotesk-Semibold.otf'); font-weight: 800 900; font-display: swap; }
  :global(*) { box-sizing: border-box; border-radius: 0; }
  :global(body) { margin: 0; background: #f00000; color: #0c0c0c; font-family: Founders, Arial, sans-serif; }
  :global(body)::before { position: fixed; inset: 0; z-index: -1; pointer-events: none; content: ''; opacity: .12; background-image: linear-gradient(135deg, transparent 0 49%, #0c0c0c 49% 50%, transparent 50% 100%); background-size: 22px 22px; }
  .site-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 80px; padding: 0 max(18px, calc((100vw - 1180px) / 2)); border-bottom: 2px solid #0c0c0c; }
  .brand { color: inherit; font-size: 13px; font-weight: 900; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .brand { font-size: 25px; letter-spacing: -.03em; }
  .brand span { display: inline-block; width: 9px; height: 9px; margin-left: 5px; background: #0c0c0c; }
  .social-nav { display: flex; gap: clamp(18px, 3vw, 36px); }
  .social-nav a { color: inherit; font-size: 11px; font-weight: 900; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }
  .social-nav a:hover, .social-nav a:focus-visible { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .next-show { justify-self: end; padding: 12px 15px; border: 2px solid #0c0c0c; background: #0c0c0c; color: #f00000; box-shadow: 4px 4px 0 rgba(12, 12, 12, .25); font-size: 11px; font-weight: 900; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .next-show:hover, .next-show:focus-visible { background: transparent; color: #0c0c0c; box-shadow: 2px 2px 0 #0c0c0c; transform: translate(2px, 2px); }
  .show-page { display: flex; flex-direction: column; width: min(100% - 36px, 1180px); min-height: calc(100vh - 80px); margin: auto; padding: 24px 0 88px; }
  .show-media { width: 100%; padding: 7px; border: 3px solid #0c0c0c; background: #0c0c0c; box-shadow: 8px 8px 0 #0c0c0c; }
  img { display: block; width: 100%; height: clamp(280px, 82vw, 380px); object-fit: cover; filter: grayscale(1) contrast(1.25); }
  .show-copy { width: 100%; margin-top: 30px; }
  .eyebrow { display: inline-block; margin: 0 0 12px; padding: 6px 8px; background: #0c0c0c; color: #f00000; font-size: 10px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  h1 { margin: 0 0 32px; font-size: clamp(52px, 9vw, 108px); line-height: .8; letter-spacing: -.075em; overflow-wrap: anywhere; text-transform: uppercase; }
  .meta { display: flex; flex-direction: column; align-items: flex-start; gap: 9px; padding: 16px 0; border-block: 2px solid #0c0c0c; }
  .meta strong { font-size: 18px; line-height: 1; letter-spacing: -.02em; text-transform: uppercase; }
  .meta a { color: inherit; font-size: 11px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; text-underline-offset: 4px; }
  .lineup { width: 100%; margin-top: 28px; border-block: 2px solid #0c0c0c; text-align: left; scroll-margin-top: 20px; }
  .lineup-head { display: flex; justify-content: space-between; align-items: center; padding: 13px 15px; border-bottom: 2px solid #0c0c0c; }
  .lineup h2, .lineup-head span { margin: 0; font-size: 11px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .lineup ul { margin: 0; padding: 0 15px; list-style: none; }
  .lineup li { display: flex; justify-content: space-between; align-items: center; gap: 24px; min-height: 48px; padding: 10px 0; border-bottom: 1px solid rgba(12, 12, 12, .35); }
  .lineup li:last-child { border-bottom: 0; }
  .lineup li > strong { font-size: 18px; line-height: 1; letter-spacing: -.02em; text-transform: uppercase; }
  .lineup-links { display: flex; flex: 0 0 auto; gap: 13px; }
  .lineup-links a { color: inherit; font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; text-underline-offset: 3px; }
  .lineup-source { opacity: .58; }
  .actions { width: 100%; margin-top: 28px; scroll-margin-top: 20px; }
  .ticket { display: block; padding: 17px 20px; border: 2px solid #0c0c0c; background: #0c0c0c; color: #f00000; font-size: 14px; font-weight: 900; letter-spacing: .04em; text-decoration: none; text-transform: uppercase; box-shadow: 5px 5px 0 rgba(12, 12, 12, .25); transition: transform .18s ease, background .18s ease, color .18s ease, box-shadow .18s ease; }
  .ticket:hover, .ticket:focus-visible { background: transparent; color: #0c0c0c; box-shadow: 3px 3px 0 #0c0c0c; transform: translate(2px, 2px); }
  .muted { opacity: .55; }
  footer { display: flex; justify-content: space-between; align-items: end; padding: 40px max(18px, calc((100vw - 1180px) / 2)); background: #0c0c0c; color: #f4f1ea; text-transform: uppercase; }
  footer strong { font-size: clamp(32px, 5vw, 52px); line-height: .8; letter-spacing: -.06em; }
  footer span { color: #f00000; font-size: 11px; font-weight: 900; letter-spacing: .15em; }
  @media (max-width: 767px) {
    .site-header { display: flex; flex-wrap: wrap; gap: 14px; height: auto; min-height: 64px; padding-block: 14px; }
    .next-show { margin-left: auto; padding: 10px 12px; }
    .social-nav { order: 3; width: 100%; justify-content: space-between; padding-top: 12px; border-top: 1px solid rgba(12, 12, 12, .35); }
    .social-nav a { font-size: 10px; }
    h1 { margin-bottom: 18px; font-size: clamp(42px, 13vw, 58px); line-height: .88; letter-spacing: -.055em; }
    .lineup li { align-items: flex-start; }
    .lineup li > strong { max-width: 55%; font-size: 16px; }
    .lineup-links { flex-direction: column; align-items: flex-end; gap: 5px; }
    footer { align-items: center; }
  }
  @media (min-width: 768px) {
    .show-page { flex-direction: row; align-items: flex-start; gap: clamp(40px, 6vw, 88px); padding-block: clamp(48px, 7vw, 88px); }
    .show-media { position: sticky; top: 32px; flex: 0 1 42%; }
    img { height: auto; max-height: 72vh; }
    .show-copy { flex: 1 1 58%; min-width: 0; margin-top: 0; }
    h1 { font-size: clamp(54px, 7vw, 92px); }
    .meta { border-block-width: 4px; }
    .meta strong { font-size: clamp(24px, 3vw, 36px); }
    .lineup { margin-top: 30px; border: 2px solid #0c0c0c; }
    .actions { display: flex; gap: 16px; }
    .ticket { flex: 1; }
  }
</style>
