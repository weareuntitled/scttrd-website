---
import { getShows, showSlug } from '../../lib/cms.ts';

const shows: any[] = await getShows();
const show = shows.find((item) => showSlug(item.data.venue, item.data.date) === Astro.params.slug);
if (!show) return Astro.redirect('/');
const { venue, city, date, status, image, imageAlt, link, lineup = [] } = show.data;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${venue}, ${city}`)}`;
const linkLabel = link && /youtube\.com|youtu\.be/i.test(link) ? 'Video ansehen ↗' : 'Veranstaltungsseite ↗';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{venue} | SCTTRD</title>
  </head>
  <body>
    <main class="show-page">
      <a class="back" href="/">SCTTRD</a>
      <div class="show-layout">
        {image && <img src={image} alt={imageAlt || venue} />}
        <section>
          <p class="eyebrow">{status === 'upcoming' ? 'upcoming show' : 'past show'}</p>
          <h1>{venue}</h1>
          <p class="meta"><strong>{city}</strong> · {date}</p>
          <a class="location" href={mapUrl} target="_blank" rel="noopener noreferrer">Ort in Google Maps öffnen ↗</a>
          {link ? <a class="ticket" href={link} target="_blank" rel="noopener noreferrer">{status === 'upcoming' ? 'Tickets sichern ↗' : linkLabel}</a> : status === 'upcoming' && <p class="muted">Ticketlink folgt.</p>}
          {lineup.length > 0 && <div class="lineup">
            <h2>Gemeinsam beim Singoldsand Festival</h2>
            <ul>
              {lineup.map((artist) => <li>
                {artist.url ? <a href={artist.url} target="_blank" rel="noopener noreferrer">{artist.name} ↗</a> : <span>{artist.name}</span>}
                {artist.sourceUrl && <a class="source" href={artist.sourceUrl} target="_blank" rel="noopener noreferrer">Festivalprofil</a>}
              </li>)}
            </ul>
          </div>}
        </section>
      </div>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f4f1ea; color: #111; font-family: Arial, sans-serif; }
  .show-page { max-width: 1180px; margin: auto; padding: 28px clamp(18px, 5vw, 70px) 80px; }
  .back { color: inherit; font-weight: 800; letter-spacing: .12em; text-decoration: none; text-transform: uppercase; }
  .show-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, .9fr); gap: clamp(28px, 7vw, 100px); align-items: end; min-height: 78vh; }
  img { width: 100%; max-height: 70vh; object-fit: cover; border-radius: 8px; }
  .eyebrow { color: #f00000; font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  h1 { margin: 0 0 14px; font-size: clamp(48px, 8vw, 120px); line-height: .86; letter-spacing: -.08em; text-transform: uppercase; }
  .meta { font-size: 18px; opacity: .8; }
  .meta strong { color: #f00000; }
  .location { display: inline-block; margin-top: 14px; color: #111; font-size: 13px; font-weight: 800; text-decoration: underline; text-underline-offset: 4px; }
  .ticket { display: inline-block; margin-top: 28px; padding: 14px 18px; background: #f00000; color: #111; font-weight: 800; text-decoration: none; }
  .muted { opacity: .5; }
  .lineup { margin-top: 48px; }
  .lineup h2 { margin: 0 0 14px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; }
  .lineup ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; font-size: 14px; }
  .lineup li { display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px solid #ccc; padding-bottom: 7px; }
  .lineup a { color: inherit; }
  .lineup .source { opacity: .5; font-size: 11px; }
  @media (max-width: 700px) { .show-layout { grid-template-columns: 1fr; min-height: auto; margin-top: 56px; } img { max-height: 55vh; } }
</style>
