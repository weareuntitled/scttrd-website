---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getShows, showSlug } from '../../lib/cms.ts';
import { nextShow as hubNextShow, showUrl, showAction, adjacentShows } from '../../lib/show.ts';
import { trackedTicketUrl } from '../../lib/tracking.ts';
import { showEventSchema, breadcrumbSchema, absoluteUrl, truncateDescription, DEFAULT_OG_IMAGE } from '../../lib/seo.ts';
import '../../styles/show.css';

const shows: any[] = await getShows();
const nextShow = hubNextShow(shows);
const nextShowHref = nextShow ? showUrl(nextShow) : null;
const show = shows.find((item) => showSlug(item.data.venue, item.data.date) === Astro.params.slug);
if (!show) return Astro.redirect('/');
const { venue, city, date, status, description = '', address = '', doorsTime = '', startTime = '', image, imageAlt, lineup = [] } = show.data;
const { prev, next } = adjacentShows(shows, show);
const mapQuery = [venue, address || city].filter(Boolean).join(', ');
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
const metaDescription = description.trim().length > 0
  ? truncateDescription(description)
  : `SCTTRD live: ${venue}, ${city} am ${date}.`;
const action = showAction(show);
const ctaLabel = action.label;
const ctaHref = trackedTicketUrl(show, { source: 'homepage', medium: 'ticket-button' }) ?? action.href;
const ogImage = absoluteUrl(image || DEFAULT_OG_IMAGE);
const structuredData = [
  showEventSchema(show),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Shows', url: '/#shows' },
    { name: venue, url: showUrl(show) },
  ]),
];
---
<BaseLayout
  title={`${venue} | SCTTRD`}
  description={metaDescription}
  currentPath={Astro.url.pathname}
  nextShowUrl={nextShowHref}
  canonical={`https://scttrd.de${showUrl(show)}`}
  bodyClass="show-body"
  image={ogImage}
>
    <Fragment slot="head">
      {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)}></script>)}
    </Fragment>
    <main class="show-page">
      <div class="show-main">
        {image && <div class="show-media"><img src={image} alt={imageAlt || venue} /></div>}
        <section class="show-copy">
          <Breadcrumbs items={[{ label: 'Home', url: '/' }, { label: 'Shows', url: '/#shows' }, { label: venue }]} />
          <p class="show-eyebrow">SCTTRD Live // {status === 'upcoming' ? 'Upcoming' : 'Archive'}</p>
          <h1 class="show-title">{venue}</h1>
          <div class="show-meta">
            <strong>{city} · {date}</strong>
            {(doorsTime || startTime || address) && (
              <ul class="show-details">
                {doorsTime && <li><span>Einlass</span><strong>{doorsTime} Uhr</strong></li>}
                {startTime && <li><span>Beginn</span><strong>{startTime} Uhr</strong></li>}
                {address && <li><span>Adresse</span><strong>{address}</strong></li>}
              </ul>
            )}
            <a href={mapUrl} target="_blank" rel="noopener noreferrer">Ort in Google Maps öffnen ↗</a>
          </div>
          {description.trim() && <p class="show-description">{description.trim()}</p>}
          <div class:list={['show-actions', status === 'upcoming' && ctaHref ? 'show-actions-sticky-dupe' : '']} id="tickets">
            {ctaHref ? <a class="show-ticket" href={ctaHref} target="_blank" rel="noopener noreferrer">{ctaLabel}</a> : status === 'upcoming' && <p class="show-muted">{ctaLabel}</p>}
          </div>
        </section>
      </div>
      <div class="show-extra">
        {(prev || next) && <nav class="show-pager" aria-label="Weitere Shows">
          {prev ? <a class="pager-link" href={showUrl(prev)}><span class="pager-dir">← früher</span><strong>{prev.data.venue}</strong><span class="pager-meta">{prev.data.city} · {prev.data.date}</span></a> : <span class="pager-link pager-empty"></span>}
          {next ? <a class="pager-link pager-next" href={showUrl(next)}><span class="pager-dir">später →</span><strong>{next.data.venue}</strong><span class="pager-meta">{next.data.city} · {next.data.date}</span></a> : <span class="pager-link pager-empty"></span>}
        </nav>}
        {lineup.length > 0 && <div class="lineup-acts" id="lineup">
          <div class="lineup-acts-head"><h2>Weitere Acts</h2><span>{lineup.length}</span></div>
          <ul class="lineup-acts-list">
            {lineup.map((artist) => {
              const href = artist.url || artist.sourceUrl;
              return href ? <li><a href={href} target="_blank" rel="noopener noreferrer">{artist.name} ↗</a></li> : <li>{artist.name}</li>;
            })}
          </ul>
        </div>}
      </div>
    </main>
    {status === 'upcoming' && ctaHref && <a class="show-ticket-sticky" href={ctaHref} target="_blank" rel="noopener noreferrer">{ctaLabel}</a>}
    <SiteFooter />
</BaseLayout>
