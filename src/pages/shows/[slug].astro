---
import { getShows, showSlug } from '../../lib/cms.ts';

const shows: any[] = await getShows();
const show = shows.find((item) => showSlug(item.data.venue, item.data.date) === Astro.params.slug);
if (!show) return Astro.redirect('/');
const { venue, city, date, status, image, imageAlt, link, lineup = [] } = show.data;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${venue}, ${city}`)}`;
const linkLabel = link && /youtube\.com|youtu\.be/i.test(link) ? 'Video ansehen ↗' : 'Veranstaltungsseite ↗';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{venue} | SCTTRD</title>
  </head>
  <body>
    <main class="show-page">
      <a class="back" href="/">SCTTRD</a>
      <div class="show-layout">
        <div class="show-media">
          {image && <img src={image} alt={imageAlt || venue} />}
          {lineup.length > 0 && <div class="lineup">
            <h2>Mit dabei</h2>
            <ul>
              {lineup.map((artist) => <li>
                {artist.url ? <a href={artist.url} target="_blank" rel="noopener noreferrer">{artist.name} ↗</a> : <span>{artist.name}</span>}
                {artist.sourceUrl && <a class="source" href={artist.sourceUrl} target="_blank" rel="noopener noreferrer">Quelle</a>}
              </li>)}
            </ul>
          </div>}
        </div>
        <section>
          <p class="eyebrow">{status === 'upcoming' ? 'upcoming show' : 'past show'}</p>
          <h1>{venue}</h1>
          <p class="meta"><strong>{city}</strong> · {date}</p>
          <a class="location" href={mapUrl} target="_blank" rel="noopener noreferrer">Ort in Google Maps öffnen ↗</a>
          {link ? <a class="ticket" href={link} target="_blank" rel="noopener noreferrer">{status === 'upcoming' ? 'Tickets sichern ↗' : linkLabel}</a> : status === 'upcoming' && <p class="muted">Ticketlink folgt.</p>}
        </section>
      </div>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f00000; color: #0c0c0c; font-family: Arial, sans-serif; }
  :global(body)::before { position: fixed; inset: 0; z-index: -1; pointer-events: none; content: ''; opacity: .12; background-image: linear-gradient(135deg, transparent 0 49%, #0c0c0c 49% 50%, transparent 50% 100%); background-size: 22px 22px; }
  .show-page { max-width: 1320px; min-height: 100vh; margin: auto; padding: 28px clamp(18px, 5vw, 70px) 80px; }
  .back { display: inline-block; color: inherit; font-size: 12px; font-weight: 900; letter-spacing: .14em; text-decoration: none; text-transform: uppercase; }
  .back::before { display: inline-block; margin-right: 10px; content: '←'; font-size: 18px; vertical-align: -2px; }
  .show-layout { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(280px, .88fr); gap: clamp(34px, 7vw, 110px); align-items: center; min-height: 78vh; }
  .show-media { min-width: 0; }
  img { display: block; width: 100%; max-height: 66vh; object-fit: cover; border: 3px solid #0c0c0c; border-radius: 0; box-shadow: 14px 14px 0 #0c0c0c; }
  .eyebrow { display: inline-block; margin: 0 0 18px; padding: 7px 9px; background: #0c0c0c; color: #f00000; font-size: 11px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  h1 { max-width: 760px; margin: 0 0 18px; font-size: clamp(48px, 8vw, 124px); line-height: .82; letter-spacing: -.085em; text-transform: uppercase; }
  .meta { margin: 0; font-size: clamp(18px, 2vw, 26px); font-weight: 700; letter-spacing: -.03em; }
  .meta strong { color: #0c0c0c; }
  .location { display: inline-block; margin-top: 22px; color: #0c0c0c; font-size: 13px; font-weight: 900; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .ticket { display: inline-block; margin-top: 28px; padding: 15px 19px; border: 2px solid #0c0c0c; background: #0c0c0c; color: #f00000; font-size: 13px; font-weight: 900; letter-spacing: .04em; text-decoration: none; text-transform: uppercase; box-shadow: 5px 5px 0 rgba(12, 12, 12, .25); transition: transform .18s ease, background .18s ease, color .18s ease, box-shadow .18s ease; }
  .ticket:hover, .ticket:focus-visible { background: transparent; color: #0c0c0c; box-shadow: 3px 3px 0 #0c0c0c; transform: translate(2px, 2px); }
  .muted { opacity: .55; }
  .lineup { margin-top: 22px; }
  .lineup h2 { margin: 0 0 8px; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; opacity: .65; }
  .lineup ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 18px; margin: 0; padding: 0; list-style: none; font-size: 11px; font-weight: 700; }
  .lineup li { display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px solid rgba(12, 12, 12, .35); padding-bottom: 4px; }
  .lineup a { color: inherit; text-decoration: none; }
  .lineup a:first-child:hover, .lineup a:first-child:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
  .lineup .source { opacity: .55; font-size: 9px; text-transform: uppercase; }
  @media (max-width: 700px) {
    .show-page { padding-top: 22px; }
    .show-layout { grid-template-columns: 1fr; gap: 48px; min-height: auto; margin-top: 58px; }
    img { max-height: 55vh; box-shadow: 8px 8px 0 #0c0c0c; }
    h1 { font-size: clamp(52px, 17vw, 92px); }
  }
</style>
