{
  "name": "scttrd-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "astro check",
    "build": "astro build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "content:check": "npm --prefix cms run content:check --",
    "content:plan": "npm --prefix cms run content:plan --",
    "content:apply": "npm --prefix cms run content:apply --",
    "content:verify": "npm --prefix cms run content:verify --",
    "verify": "npm run lint && npm run build",
    "preview": "astro preview",
    "rider:pdf": "node scripts/rider-pdf.mjs",
    "content:sync": "npm --prefix cms run content:sync --"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/nodemailer": "^8.0.2",
    "astro": "^7.2.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "nodemailer": "^10.0.10"
  }
}
