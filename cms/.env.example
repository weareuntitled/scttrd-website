# SCTTRD CMS (Payload 3) — .env
# Lokal: cp .env.example .env (Werte anpassen). Prod: auf dem VPS + compose.prod.yaml nutzen.

# --- Datenbank (Postgres) ---
POSTGRES_DB=scttrd_cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql://cms:change-me-db-password@db:5432/scttrd_cms

# --- Payload ---
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32
PAYLOAD_PUBLIC_SERVER_URL=https://cms.scttrd.de
PORT=3000
# Schema-Push beim Start (true = kein Migrations-Setup nötig)
PAYLOAD_PUSH=true

# --- Domain / Proxy (nur prod, für compose.prod.yaml) ---
# DATABASE_URL im Compose wird intern eh überschrieben; hier nur APP_DOMAIN für caddy.
APP_DOMAIN=cms.scttrd.de