# ===== SCTTRD Docmost Wiki — .env =====
# Kopieren mit: cp .env.example .env   (Dienst wertet .env aus jenem Verzeichnis aus)
# Danach Secrets ändern! Alle Werte, die "change" enthalten, ersetzen.

# --- Domain / Proxy ---
APP_DOMAIN=docs.scttrd.de

# --- Docmost App ---
APP_URL=https://docs.scttrd.de
# Sicherer Schlüssel, mindestens 32 Zeichen. Erzeugen mit:  openssl rand -hex 32
APP_SECRET=change-me-32-char-min-secret
# Keine anonymen Metriken an Docmost senden
DISABLE_TELEMETRY=true
# Upload-Limits
FILE_UPLOAD_SIZE_LIMIT=50mb
FILE_IMPORT_SIZE_LIMIT=200mb

# --- Datenbank ---
POSTGRES_DB=docmost
POSTGRES_USER=docmost
POSTGRES_PASSWORD=change-me-db-password

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- E-Mail (optional, aber für Einladungen empfohlen) ---
# Ohne SMTP läuft Docmost, aber Einladungs-/Reset-Mails werden nicht zugestellt.
#MAIL_DRIVER=smtp
#SMTP_HOST=mail.example.com
#SMTP_PORT=587
#SMTP_USERNAME=wiki@scttrd.de
#SMTP_PASSWORD=change-me-mail-password
#SMTP_SECURE=false
#MAIL_FROM_ADDRESS=wiki@scttrd.de
#MAIL_FROM_NAME=SCTTRD Wiki

# --- Persistenz-Hinweis ---
# Alle Daten liegen in Docker-Volumes (docmost_data / db_data / redis_data).
# Backup: siehe README.md Abschnitt "Backup".